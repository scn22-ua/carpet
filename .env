# ─────────────────────────────────────────────────────────────────
#  Water Management Network – Variables de entorno para Docker
#  Edita estos valores según tu despliegue en Railway
# ─────────────────────────────────────────────────────────────────

# Broker Kafka (Railway TCP Proxy)
KAFKA_BROKER=caboose.proxy.rlwy.net:37367

# Dirección pública de WM_Central en Railway
# Puerto 9000 → WM_WS_M (monitores de estación)
CENTRAL_WS_ADDR=metro.proxy.rlwy.net:26248

# Saltar autenticación por socket TCP del FO (1=sí, 0=no)
# Ponlo a 1 cuando el puerto 9001 de Central no esté expuesto en Railway
SKIP_FO_AUTH=1

